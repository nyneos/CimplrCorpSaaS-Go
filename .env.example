# Copy to .env and fill in. Do not commit .env.
# Required = the process cannot serve without it.
# Optional = the code has a default, or the feature stays off when blank.

# --- Required: database ---
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# require for hosted Postgres. disable only for a local database.
DB_SSLMODE=require
DB_POOL_MAX_CONNS=

# --- Required: gateway ---
# Listen port. PORT overrides the port in services.yaml.
PORT=
GATEWAY_PORT=
PATH_PREFIX=
# 32-byte keys, base64. Same values the web build uses to encrypt payloads.
PAYLOAD_ENC_KEY=
RESPONSE_ENC_KEY=
# Optional AES-GCM key for email/IMAP/Graph/OAuth secrets at rest (base64 32 bytes).
# Generate: openssl rand -base64 32
# When unset, credentials stay plaintext (backward compatible; one warning is logged).
SECRETS_ENC_KEY=
# Max multipart/JSON body size for uploads (bytes). Default 16777216 (16 MiB). Recommended 10–25 MiB.
UPLOAD_MAX_BYTES=16777216
# Public URL of the web app. SSO redirects here.
FRONTEND_URL=http://localhost:5173
TLS_CERT=
TLS_KEY=

# --- Required when the feature is turned on ---
# true = ignore body user_id and accept only X-Session-Id. Leave false until the web build sends the header.
AUTH_REQUIRE_SESSION_TOKEN=false
# REQUIRED for MFA setup/verify (fail-closed when blank or invalid).
# Generate: openssl rand -base64 32  (must decode to exactly 32 bytes).
# Never put a real production key in this example file.
MFA_SECRET_KEY=
# RBAC gate on mutating routes via middlewares.RequirePermission.
#   on / true / enforce = deny when role lacks page+action (use in prod)
#   off / false          = skip checks
#   blank (default)      = log denials only, still allow the request
PERMISSION_ENFORCE=on
# true = a maker may approve their own request.
APPROVAL_ALLOW_SELF_APPROVAL=false
APPROVAL_SYSTEM_USER_ID=
DEVEL_MODE=false
ENV=
APP_PORT=
ENV_FILE_PATH=
PREVALIDATION_DEBUG=false

# --- Optional: admin override (bypasses RequirePermission when enabled) ---
# ENABLE_ADMIN_OVERRIDE=true turns on the override path in session middleware.
# ADMIN_USER_IDS = comma-separated user UUIDs treated as admin.
# ADMIN_ROLES = comma-separated role names/codes treated as admin (e.g. superadmin).
ENABLE_ADMIN_OVERRIDE=false
ADMIN_USER_IDS=
ADMIN_ROLES=

# --- Optional: module listen ports (defaults are in services.yaml) ---
CASH_PORT=

# --- Optional: AWS / storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
UPLOAD_TO_STORAGE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
BANK_STMT_S3_ENABLED=false
BANK_STMT_S3_BUCKET=
BANK_STMT_S3_REGION=
BANK_STMT_S3_BASE_URL=
BANK_STMT_ROOT_PREFIX=
BANK_STMT_PREFIX_MAP=
BANK_STMT_URL_EXPIRY_HOURS=
BANK_STMT_DEBUG_PARSE=false
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=
DOCUMENT_SERVICE_KEY=

# --- Optional: bank statement conversion ---
BANK_STATEMENT_USE_LLM=false
USE_PDFCO=false
PDFCO_API_KEY=
CONVERT_SVC_KEY=
FIN_PDF_UPLOAD_URL=
SMART_CAT_AI_URL=
SMART_CAT_AI_KEY=
SMART_CAT_WORKERS=
AI_INFERENCE_BULK_CHUNK_SIZE=
AI_INFERENCE_BULK_CONCURRENCY=
AI_INFERENCE_BULK_TIMEOUT_SEC=
CATEGORIZATION_SCHEDULE=
CATEGORIZATION_BATCH_SIZE=
STREAM_ACCESS_KEYS=

# --- Optional: SSO (blank = that provider is off) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=
AZURE_GRAPH_TENANT_LABEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DWD_CLIENT_ID=
GOOGLE_DWD_PRIVATE_KEY=
GOOGLE_DWD_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_TENANT_LABEL=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# --- Optional: email ---
EMAIL_SERVICE_URL=http://localhost:8182
EMAIL_SERVICE_KEY=
EMAIL_ALLOWED_MAILBOX_DOMAINS=
EMAIL_POLLER_ENABLED=true
EMAIL_POLL_INTERVAL_SECS=60
EMAIL_POLL_BATCH_SIZE=
IMAP_POLLER_ENABLED=true
IMAP_POLL_INTERVAL_SECS=
GRAPH_POLLER_ENABLED=true
GRAPH_POLL_INTERVAL_SECS=
OAUTH_POLLER_ENABLED=true
OAUTH_POLL_INTERVAL_SECS=
GOOGLE_WORKSPACE_POLLER_ENABLED=true
GOOGLE_WORKSPACE_POLL_INTERVAL_SECS=
MAIL_OAUTH_MS_CLIENT_ID=
MAIL_OAUTH_MS_CLIENT_SECRET=
MAIL_OAUTH_GOOGLE_CLIENT_ID=
MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_URI=
MAIL_OAUTH_FRONTEND_URL=
OAUTH_REDIRECT_BASE_URL=
MAIL_RUNTIME_HEALTH_TIMEOUT_SECS=
