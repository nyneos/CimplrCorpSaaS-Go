EMAIL_INBOUND_S3_PARSED_PREFIX=
EMAIL_INBOUND_S3_ATTACH_PREFIX=
EMAIL_SES_RULE_SET_NAME=
EMAIL_SES_IAM_ROLE_ARN=
EMAIL_TRANSFORMED_LOCAL_DIR=
CIMPLR_TRANSFORMED_LOCAL_DIR=

# --- Optional: policy, documents, sweeps, dashboards ---
POLICY_SERVICE_KEY=
POLICY_ENGINE_ENABLED=false
DMS_ENABLED=false
DMS_LOCAL_OUTPUT_DIR=
DMS_EMAIL_ALLOWED_DOMAINS=
DMS_EMAIL_MAX_ATTACHMENT_BYTES=
DMS_EMAIL_MAX_ATTACHMENT_COUNT=
DMS_GENERATION_QUEUE_ENABLED=false
DMS_GENERATION_WORKER_POLL_MS=
DMS_GENERATION_WORKER_BATCH_SIZE=
DMS_GENERATION_WORKER_TIMEOUT_SECS=
DMS_GENERATION_WORKER_MAX_CONCURRENT=
DMS_GENERATION_BATCH_SIZE=
DMS_GENERATION_LEASE_SECONDS=
DMS_GENERATION_MAX_ATTEMPTS=
DMS_GENERATION_MAX_CONCURRENT=
TRANSFORM_TOOL_URL=
# Deprecated misspelling aliases (still read if TRANSFORM_TOOL_URL is empty):
# TRANSFORMATION_TOOL_URL=
# TRANSFORMAT_TOOL_URL=
TRANSFORM_MAX_CONCURRENT=
SWEEP_MAX_RETRIES=
FD_AUTO_MATURITY_INTERVAL_MINUTES=
INVESTMENT_DASHBOARD_CACHE_TTL_SECONDS=
SEND_ENDPOINT_URL=
SEND_ENDPOINT_API_KEY=

# --- Optional: notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
BROWSER_PUSH_ENABLED=true
BROWSER_PUSH_POLL_SECS=15
BROWSER_PUSH_BATCH_SIZE=50
BROWSER_PUSH_DIGEST_MINS=30
BROWSER_PUSH_DIGEST_THROTTLE=90
BROWSER_PUSH_DIGEST_TOP_N=5
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_SECS=10
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_TIMEOUT_SECS=120
IN_APP_WORKER_ENABLED=true
IN_APP_WORKER_POLL_SECS=15
IN_APP_WORKER_BATCH=50
NOTIF_NUDGE_AFTER_ENQUEUE=

# --- Optional: browser event stream ---
# Origin allowed to open /events. Blank allows any origin.
SSE_ALLOWED_ORIGIN=

# --- Optional: tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=
OTEL_ENVIRONMENT=
BETTERSTACK_SOURCE_TOKEN=
CIMPLR_DEPLOYMENT_URL=
CIMPLR_SERVICE_NAME=
